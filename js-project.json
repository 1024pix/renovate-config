{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>1024pix/renovate-config:default",
    "local>1024pix/renovate-config//presets/js/group-by-directory",
    "local>1024pix/renovate-config//presets/js/1024pix",
    "local>1024pix/renovate-config//presets/js/infra",
    "local>1024pix/renovate-config//presets/js/lint-and-test",
    "local>1024pix/renovate-config//presets/js/node",
    "local>1024pix/renovate-config//presets/js/tools",
    "local>1024pix/renovate-config//presets/js/open-telemetry-api",
    "local>1024pix/renovate-config//presets/js/open-telemetry-experimental",
    "local>1024pix/renovate-config//presets/js/open-telemetry-contrib",
    "local>1024pix/renovate-config//presets/js/open-telemetry-semantic-conventions"
  ],
  "schedule": ["* * * * 1-5"],
  "packageRules": [
    {
      "description": "Dépendances de développement : la range du manifeste est alignée (bump) sur la nouvelle version installée",
      "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
      "rangeStrategy": "bump"
    }
  ]
}
