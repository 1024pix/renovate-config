{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>1024pix/renovate-config:default",
    "local>1024pix/renovate-config//presets/js/1024pix-dependencies-config.json",
    "local>1024pix/renovate-config//presets/js/group-by-directory",
    "local>1024pix/renovate-config//presets/js/infra-dependencies-config.json",
    "local>1024pix/renovate-config//presets/js/lint-and-test-dependencies-config.json",
    "local>1024pix/renovate-config//presets/js/node-dependencies-config.json",
    "local>1024pix/renovate-config//presets/js/open-telemetry-api",
    "local>1024pix/renovate-config//presets/js/open-telemetry-experimental",
    "local>1024pix/renovate-config//presets/js/open-telemetry-contrib.json",
    "local>1024pix/renovate-config//presets/js/open-telemetry-semantic-conventions.json"
  ],
  "packageRules": [
    {
      "description": "Dépendances de développement : la range du manifeste est alignée (bump) sur la nouvelle version installée",
      "matchDepTypes": ["devDependencies", "dev-dependencies", "dev"],
      "rangeStrategy": "bump"
    }
  ]
}
