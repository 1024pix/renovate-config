{
  "name": "renovate-config",
  "version": "0.0.0",
  "private": false,
  "license": "AGPL-3.0",
  "engines": {
    "node": "^24.0.0"
  },
  "description": "1024pix shared renovate config",
  "scripts": {
    "lint:fix": "prettier --write .",
    "lint": "prettier --check .",
    "test": "run-p validate:**",
    "validate:default": "renovate-config-validator --strict default.json",
    "validate:data-project": "renovate-config-validator --strict data-project.json",
    "validate:js-project": "renovate-config-validator --strict js-project.json",
    "validate:presets": "renovate-config-validator --strict presets/*.json presets/**/*.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1024pix/renovate-config.git"
  },
  "keywords": [
    "renovate",
    "config"
  ],
  "author": "1024pix team",
  "bugs": {
    "url": "https://github.com/1024pix/renovate-config/issues"
  },
  "homepage": "https://github.com/1024pix/renovate-config#readme",
  "devDependencies": {
    "npm-run-all2": "^9.0.0",
    "prettier": "^3.0.0",
    "renovate": "^42.0.0"
  }
}
