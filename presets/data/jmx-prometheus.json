{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["customManagers:dockerfileVersions"],
  "customManagers": [
    {
      "description": "Track JMX Prometheus agent version in PixSparkKubernetesOperator.py",
      "customType": "regex",
      "matchStrings": [
        "jmx_prometheus_javaagent-(?<currentValue>[\\d.]+)\\.jar",
        "JMX_EXPORTER_AGENT_VERSION=(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "prometheus/jmx_exporter",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": [
        "/data-pipelines/data_pipelines/helpers/PixSparkKubernetesOperator\\.py$/",
        "Dockerfile"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Famille jmx-prometheus : ENV du Dockerfile et chemin du JAR dans le DAG",
      "matchDepNames": ["prometheus/jmx_exporter"],
      "groupName": "jmx-prometheus",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    }
  ]
}
