{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["customManagers:dockerfileVersions"],
  "customManagers": [
    {
      "description": "Track JMX Prometheus agent version in Dockerfile",
      "customType": "regex",
      "matchStrings": ["JMX_EXPORTER_AGENT_VERSION=(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "prometheus/jmx_exporter",
      "datasourceTemplate": "github-releases",
      "managerFilePatterns": ["Dockerfile"]
    }
  ],
  "packageRules": [
    {
      "description": "Famille jmx-prometheus : ENV JMX_EXPORTER_AGENT_VERSION du Dockerfile",
      "matchDepNames": ["prometheus/jmx_exporter"],
      "groupName": "jmx-prometheus",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false
    }
  ]
}
