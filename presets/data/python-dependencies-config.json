{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Famille python (couplée) : .python-version ; requires-python et le suffixe -pythonX.Y du tag airflow restent manuels",
      "matchDepNames": ["python"],
      "groupName": "python",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "allowedVersions": "/^3\\.12/"
    },
    {
      "description": "Famille outillage-python : ruff, pytest et ses plugins, dans [dependency-groups] dev",
      "matchDepTypes": ["dependency-groups", "tool.uv.dev-dependencies"],
      "matchPackageNames": ["ruff", "pytest", "/^pytest-/"],
      "groupName": "outillage-python"
    }
  ]
}
