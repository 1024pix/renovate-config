{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Scala : binaire 2.12 imposé par Spark 3.5",
      "matchPackageNames": ["org.scala-lang:scala-library"],
      "allowedVersions": "/^2\\.12\\./"
    },
    {
      "description": "Famille outillage-scala : plugins sbt de project/plugins.sbt et version scalafmt de .scalafmt.conf",
      "matchDepNames": ["scalafmt", "/:sbt-/"],
      "groupName": "outillage-scala"
    },
    {
      "description": "Famille tests-scala : scalatest et scalactic, publies ensemble et toujours a la meme version",
      "matchPackageNames": ["/^org\\.scalatest:/", "/^org\\.scalactic:/"],
      "groupName": "tests-scala",
      "separateMinorPatch": false
    }
  ]
}
