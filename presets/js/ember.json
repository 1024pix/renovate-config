{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Regroupe les packages warp-drive et ember-data",
      "matchPackageNames": ["@warp-drive/**", "ember-data", "@ember-data/**"],
      "groupName": "warp-drive"
    },
    {
      "description": "Regroupe les packages ember-intl",
      "matchPackageNames": ["ember-intl", "@ember-intl/**"],
      "groupName": "ember-intl"
    }
  ]
}
