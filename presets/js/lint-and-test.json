{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Groupe les packages de lint",
      "matchPackageNames": [
        "/(prettier|stylelint|eslint|oxlint|oxfmt|@formatjs\/intl|globals|ls-lint|schemalint|ember-template-lint|@glint)/"
      ],
      "groupName": "linters",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false,
      "addLabels": ["auto-bump"],
      "automerge": true
    },
    {
      "description": "Groupe les packages de test API",
      "matchPackageNames": [
        "/(sinon|mocha|chai|vitest|nock|dependency-cruiser|knip)/"
      ],
      "groupName": "tests-api",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false,
      "addLabels": ["auto-bump"],
      "automerge": true
    },
    {
      "description": "Groupe les packages de test Front",
      "matchPackageNames": [
        "/(qunit|@ember\/test-helpers|ember-exam|miragejs)/"
      ],
      "groupName": "tests-front",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false,
      "addLabels": ["auto-bump"],
      "automerge": true
    },
    {
      "description": "Groupe les packages de test e2e",
      "matchPackageNames": ["/(cypress|playwright)/"],
      "groupName": "tests-e2e",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false,
      "addLabels": ["auto-bump"],
      "automerge": true
    },
    {
      "description": "Groupe les packages liés à typescript",
      "matchPackageNames": ["/(typescript|@types)/"],
      "groupName": "typescript",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false,
      "addLabels": ["auto-bump"],
      "automerge": true
    }
  ]
}
