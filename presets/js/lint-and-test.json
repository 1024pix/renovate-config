{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Groupe les familles de dépendances lint et test en une seule PR, tous dossiers confondus, en auto-merge avec le label auto-bump",
      "matchPackageNames": [
        "/^(eslint|@eslint|stylelint|prettier|sinon|qunit|mocha|chai|cypress|@ember/test-helpers|@formatjs/intl).*/"
      ],
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMultipleMajor": false,
      "addLabels": ["auto-bump"],
      "automerge": true
    },
    {
      "matchPackageNames": ["/(eslint.*|globals)/"],
      "groupName": "eslint"
    },
    {
      "matchPackageNames": ["/^stylelint.*/"],
      "groupName": "stylelint"
    },
    {
      "matchPackageNames": ["/^prettier.*/"],
      "groupName": "prettier"
    },
    {
      "matchPackageNames": ["/^sinon.*/"],
      "groupName": "sinon"
    },
    {
      "matchPackageNames": ["/^qunit.*/"],
      "groupName": "qunit"
    },
    {
      "matchPackageNames": ["/^mocha.*/"],
      "groupName": "mocha"
    },
    {
      "matchPackageNames": ["/^chai.*/"],
      "groupName": "chai"
    },
    {
      "matchPackageNames": ["/^cypress.*/"],
      "groupName": "cypress"
    },
    {
      "matchPackageNames": ["/^@formatjs/intl.*/"],
      "groupName": "@formatjs/intl"
    }
  ]
}
