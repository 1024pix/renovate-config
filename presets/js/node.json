{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Famille node : Node.js et l'image cimg/node sont regroupés en une seule PR pour tout le monorepo",
      "matchPackageNames": ["/^(node|cimg/node|@types/node)$/"],
      "groupName": "node",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "rangeStrategy": "bump",
      "versioning": "node"
    },
    {
      "description": "Auto-merge des montées minor/patch de la famille node",
      "matchPackageNames": ["/^(node|cimg/node|@types/node)$/"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
