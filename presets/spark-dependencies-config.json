{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Famille spark (couplée) : image de base, deps sbt, spark-testing-base et SPARK_VERSION du DAG dans une seule PR ; 4.x exige Scala 2.13",
      "matchPackageNames": [
        "spark",
        "/^org\\.apache\\.spark:/",
        "/^com\\.holdenkarau:spark-/"
      ],
      "groupName": "spark",
      "additionalBranchPrefix": "",
      "commitMessageSuffix": "",
      "separateMinorPatch": false,
      "separateMultipleMajor": false,
      "allowedVersions": "/^3\\./"
    }
  ]
}
