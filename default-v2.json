{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":semanticCommits",
    ":separateMultipleMajorReleases",
    ":prHourlyLimitNone"
  ],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "commitMessagePrefix": "[BUMP]",
  "rebaseWhen": "never",
  "schedule": ["* 0-3 * * 1-5"],
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump",
    "commitMessageSuffix": "{{#if parentDir}}({{parentDir}}){{else}}(dossier racine){{/if}} [SECURITY]",
    "reviewers": ["team:team-secu", "team:team-captains"]
  }
}
