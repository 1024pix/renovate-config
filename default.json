{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":separateMultipleMajorReleases",
    ":prHourlyLimitNone",
    ":configMigration",
    "abandonments:recommended",
    "local>1024pix/renovate-config//presets/circleci",
    "local>1024pix/renovate-config//presets/disable-automerge-and-docker-datasource-for-postgres-and-redis",
    "local>1024pix/renovate-config//presets/docker-auth",
    "local>1024pix/renovate-config//presets/github-actions",
    "local>1024pix/renovate-config//presets/scalingo-addon-datasources",
    "local>1024pix/renovate-config//presets/scalingo-postgres-custom-manager",
    "local>1024pix/renovate-config//presets/scalingo-redis-custom-manager"
  ],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "commitMessagePrefix": "[BUMP]",
  "rebaseWhen": "conflicted",
  "schedule": ["* 0-3 * * 1-5"],
  "vulnerabilityAlerts": {
    "rangeStrategy": "bump",
    "commitMessageSuffix": "{{#if parentDir}}({{parentDir}}){{else}}(dossier racine){{/if}} [SECURITY]",
    "reviewers": ["team:team-secu", "team:team-captains"],
    "automerge": false
  }
}
